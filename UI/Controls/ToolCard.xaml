<UserControl
    x:Class="MiniT.UI.Controls.ToolCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="CardBorder" Width="168" Height="122"
            CornerRadius="16" Padding="14"
            Translation="0,0,20"
            Shadow="{StaticResource CardShadow}"
            PointerEntered="OnEnter" PointerExited="OnExit">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" CenterX="84" CenterY="61"/>
                <TranslateTransform x:Name="CardTranslate" X="0" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" HorizontalAlignment="Left"
                    CornerRadius="10" Width="34" Height="34">
                <TextBlock x:Name="InitialsText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="13"/>
            </Border>
            <TextBlock Grid.Row="1" x:Name="NameText"
                       FontWeight="SemiBold" FontSize="13.5"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       VerticalAlignment="Bottom" Margin="0,6,0,0"/>
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="5" Padding="6,2"
                        HorizontalAlignment="Left">
                    <TextBlock x:Name="TypeLabel" FontSize="10" FontWeight="SemiBold"/>
                </Border>
                <Button Grid.Column="1" x:Name="MoreBtn"
                        Padding="4" FontSize="14" Click="OnMoreClick"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="6"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Add to space">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                </Button>
                <Button Grid.Column="2" x:Name="FavBtn"
                        Padding="4" FontSize="14" Click="OnFavoriteClick"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <FontIcon x:Name="FavIcon" Glyph="&#xE734;" FontSize="14"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
