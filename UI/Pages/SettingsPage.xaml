<Page
    x:Class="MiniT.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="52,*">

        <!-- Header with a real, obvious way back -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Button Grid.Column="0" x:Name="BackButton"
                    Click="OnBack" Margin="10,0,0,0"
                    Background="Transparent" BorderThickness="0"
                    Padding="10,8" CornerRadius="8"
                    ToolTipService.ToolTip="Back">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    <TextBlock Text="Back" FontSize="13"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Settings" FontWeight="SemiBold"
                       FontSize="15" VerticalAlignment="Center"
                       Margin="0,0,20,0" HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="32,24,32,32">
            <StackPanel Spacing="16" MaxWidth="520">

                <!-- Appearance -->
                <Border CornerRadius="14" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="30" Height="30" CornerRadius="8"
                                    Background="{StaticResource AppAccentSoftBrush}">
                                <FontIcon Glyph="&#xE790;" FontSize="14"
                                          Foreground="{StaticResource AppAccentBrush}"/>
                            </Border>
                            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderTextStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Header="Theme" Width="220"
                                  Margin="0,4,0,0"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="System"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                        <TextBlock Text="System follows your Windows setting."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Data location -->
                <Border CornerRadius="14" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="30" Height="30" CornerRadius="8"
                                    Background="{StaticResource AppAccentSoftBrush}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                          Foreground="{StaticResource AppAccentBrush}"/>
                            </Border>
                            <TextBlock Text="Data Location" Style="{StaticResource SectionHeaderTextStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="DataPathText" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Button x:Name="OpenFolderButton" Content="Open in Explorer" Click="OnOpenDataFolder" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Keyboard shortcuts -->
                <Border CornerRadius="14" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="30" Height="30" CornerRadius="8"
                                    Background="{StaticResource AppAccentSoftBrush}">
                                <FontIcon Glyph="&#xE765;" FontSize="14"
                                          Foreground="{StaticResource AppAccentBrush}"/>
                            </Border>
                            <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource SectionHeaderTextStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="100,*">
                                <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="5" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl+K" FontFamily="Consolas" FontSize="11.5"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Open search" VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="100,*">
                                <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="5" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="Escape" FontFamily="Consolas" FontSize="11.5"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Close search / settings / active tool"
                                           VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="100,*">
                                <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="5" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl+1..3" FontFamily="Consolas" FontSize="11.5"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Switch between the first 3 open tools"
                                           VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About -->
                <StackPanel Spacing="2" Margin="4,8,0,0">
                    <TextBlock Text="MiniT — Tool Launcher" FontSize="12.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="v1.0.0" FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
