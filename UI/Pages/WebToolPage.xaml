<Page
    x:Class="MiniT.UI.Pages.WebToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid RowDefinitions="44,*">

        <!-- Mini browser chrome: back/forward/reload + read-only address pill.
             Kept intentionally simple — this is an embedded tool surface, not
             a full browser, so no tabs/bookmarks/downloads here. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              Padding="10,6,10,6"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">

            <Button Grid.Column="0" x:Name="BackButton" Click="OnBack"
                    Width="30" Height="30" Padding="0" CornerRadius="7"
                    Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="12"/>
            </Button>

            <Button Grid.Column="1" x:Name="ForwardButton" Click="OnForward"
                    Width="30" Height="30" Padding="0" CornerRadius="7"
                    Margin="2,0,0,0"
                    Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="Forward">
                <FontIcon Glyph="&#xE72A;" FontSize="12"/>
            </Button>

            <Button Grid.Column="2" x:Name="ReloadButton" Click="OnReload"
                    Width="30" Height="30" Padding="0" CornerRadius="7"
                    Margin="2,0,0,0"
                    Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="Reload">
                <FontIcon x:Name="ReloadIcon" Glyph="&#xE72C;" FontSize="12"/>
            </Button>

            <Border Grid.Column="3" Margin="10,0,10,0" CornerRadius="8" Padding="10,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    VerticalAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="11"
                              Margin="0,0,8,0" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Grid.Column="1" x:Name="AddressText"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>

            <Button Grid.Column="4" x:Name="OpenExternalButton" Click="OnOpenExternal"
                    Width="30" Height="30" Padding="0" CornerRadius="7"
                    Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="Open in browser">
                <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <controls:WebView2 x:Name="Browser"/>

            <!-- Shown until the WebView2 runtime + navigation is ready, and on load errors. -->
            <StackPanel x:Name="StatusPanel" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressRing x:Name="LoadingRing" IsActive="True"
                              Width="28" Height="28" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Loading…"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="13"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
